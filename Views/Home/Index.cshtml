                    <option value="all">All Classes</option>
                    @for (int c = 1; c <= 10; c++)
                    {
                        <option value="@c">Class @(c)th</option>
                    }
                </select>
                <button class="btn btn-primary" onclick="openAddStudentModal()">
                    <i class="bi bi-person-plus-fill me-1"></i> + Add New Student
                </button>
            </div>
        </div>
