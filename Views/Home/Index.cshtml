    @{
        var totalStudentsCount = Model.Students.Count;
        var maleStudentsCount = Model.Students.Count(s => s.StudentGender == "Male");
        var femaleStudentsCount = Model.Students.Count(s => s.StudentGender == "Female");
        var maleRatio = totalStudentsCount > 0 ? (int)Math.Round((double)maleStudentsCount / totalStudentsCount * 100) : 52;
        var femaleRatio = 100 - maleRatio;
        var firstStudent = Model.Students.FirstOrDefault();

        var primaryCount = Model.Students.Count(s => s.Standard >= 1 && s.Standard <= 4);
        var middleCount = Model.Students.Count(s => s.Standard >= 5 && s.Standard <= 7);
        var highCount = Model.Students.Count(s => s.Standard >= 8 && s.Standard <= 10);

        var primaryPct = totalStudentsCount > 0 ? (int)Math.Round((double)primaryCount / totalStudentsCount * 100) : 35;
        var middlePct = totalStudentsCount > 0 ? (int)Math.Round((double)middleCount / totalStudentsCount * 100) : 35;
        var highPct = totalStudentsCount > 0 ? (int)Math.Round((double)highCount / totalStudentsCount * 100) : 30;
    }

