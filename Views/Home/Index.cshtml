<div id="stock-section" class="content-section">
    <div class="custom-card mb-4 print-stock-area">
        <div class="custom-card-header">
            <div class="card-title-group">
                <div class="card-icon-badge bg-warning-subtle text-warning">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <h3 class="card-title-text">School Material & Stock Inventory</h3>
                    <p class="card-subtitle-text">School Clerk Central Store Management • Connected to SQL Server</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="btn btn-outline-secondary btn-sm" onclick="printStockInventory()">
                    <i class="bi bi-printer me-1"></i> Print Stock Sheet
                </button>
                <button class="btn btn-warning text-dark fw-bold btn-sm" onclick="openAddStockModal()">
                    <i class="bi bi-plus-circle-fill me-1"></i> + Add School Material
                </button>
            </div>
        </div>

        <!-- 4 Clerk Metric Summary Boxes -->
        <div class="custom-card-body border-bottom bg-light py-3">
            <div class="row g-3">
                <div class="col-6 col-lg-3">
                    <div class="p-3 bg-white rounded-3 border shadow-xs d-flex align-items-center gap-3">
                        <div class="stat-icon-badge bg-success-subtle text-success p-2 rounded-circle">
                            <i class="bi bi-currency-rupee fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Inventory Value</span>
                            <span class="fs-5 fw-bold text-dark" id="stockTotalValue">₹@Model.TotalInventoryValue.ToString("N2")</span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="p-3 bg-white rounded-3 border shadow-xs d-flex align-items-center gap-3">
                        <div class="stat-icon-badge bg-primary-subtle text-primary p-2 rounded-circle">
                            <i class="bi bi-box-seam-fill fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Total Items</span>
                            <span class="fs-5 fw-bold text-primary" id="stockTotalItems">@Model.TotalStockItems SKUs</span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="p-3 bg-white rounded-3 border shadow-xs d-flex align-items-center gap-3">
                        <div class="stat-icon-badge bg-info-subtle text-info p-2 rounded-circle">
                            <i class="bi bi-stack fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Units in Store</span>
                            <span class="fs-5 fw-bold text-dark" id="stockTotalUnits">@Model.TotalStockUnits Units</span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="p-3 bg-white rounded-3 border shadow-xs d-flex align-items-center gap-3">
                        <div class="stat-icon-badge bg-danger-subtle text-danger p-2 rounded-circle">
                            <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                        </div>
                        <div>
                            <span class="text-muted small text-uppercase fw-semibold d-block">Low Stock Warnings</span>
                            <span class="fs-5 fw-bold @(Model.LowStockAlerts > 0 ? "text-danger" : "text-success")" id="stockLowCount">@Model.LowStockAlerts Items</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="custom-card-body pb-0 pt-3">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap" id="stockCategoryFilterButtons">
                    <button class="btn btn-sm btn-dark active stock-filter-btn" onclick="filterStockCategory('all', this)">All Materials (@Model.TotalStockItems)</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('Stationery', this)">Stationery</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('Textbooks', this)">Textbooks</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('Uniforms', this)">Uniforms</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('Science Lab', this)">Science Lab</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('Sports Equipment', this)">Sports</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('Exam Materials', this)">Exams</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('Classroom Furniture', this)">Furniture</button>
                    <button class="btn btn-sm btn-outline-secondary stock-filter-btn" onclick="filterStockCategory('IT & Electronics', this)">IT & Tech</button>
                </div>
                <div style="min-width: 260px;">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" id="stockTableSearch" class="form-control" placeholder="Search material name, SKU, vendor..." oninput="searchStockTable(this.value)" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Stock Materials Table -->
        <div class="custom-card-body p-0 mt-3">
            <div class="table-responsive">
                <table class="modern-table" id="stockTable">
                    <thead>
                        <tr>
                            <th>Item Code / SKU</th>
                            <th>Material Name & Category</th>
                            <th>Storage Location</th>
                            <th>Quantity In Store</th>
                            <th>Unit Price & Value</th>
                            <th>Stock Status</th>
                            <th class="text-end">Clerk Actions</th>
                        </tr>
                    </thead>
                    <tbody id="stockTableBody">
                        @if (Model.Stocks.Any())
                        {
                            @foreach (var item in Model.Stocks)
                            {
                                <tr data-id="@item.Id" data-category="@item.Category" data-name="@item.ItemName.ToLower()" data-sku="@item.ItemCode.ToLower()">
                                    <td>
                                        <span class="badge bg-light text-dark font-monospace border fw-bold">@item.ItemCode</span>
                                    </td>
                                    <td>
                                        <div>
                                            <strong class="d-block text-dark stock-item-name">@item.ItemName</strong>
                                            <div class="d-flex align-items-center gap-1 mt-1">
                                                <span class="badge bg-secondary-subtle text-secondary small">@item.Category</span>
                                                @if (!string.IsNullOrEmpty(item.Supplier))
                                                {
                                                    <span class="text-muted small" style="font-size: 0.72rem;">• Vendor: @item.Supplier</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary small"><i class="bi bi-geo-alt me-1 text-danger"></i>@item.Location</span>
                                    </td>
                                    <td>
                                        <div>
                                            <div class="d-flex align-items-center justify-content-between mb-1">
                                                <strong class="text-dark stock-qty-text" id="stockQty-@item.Id">@item.Quantity @item.Unit</strong>
                                                <span class="text-muted small" style="font-size: 0.7rem;">Min: @item.MinThreshold</span>
                                            </div>
                                            @{
                                                var fillPct = Math.Min(100, item.MinThreshold > 0 ? (int)Math.Round((double)item.Quantity / (item.MinThreshold * 2) * 100) : 100);
                                                var barColor = item.Quantity <= 0 ? "bg-danger" : (item.Quantity <= item.MinThreshold ? "bg-warning" : "bg-success");
                                            }
                                            <div class="progress" style="height: 5px;">
                                                <div class="progress-bar @barColor" id="stockBar-@item.Id" style="width: @(fillPct)%;"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <strong class="text-dark" id="stockVal-@item.Id">₹@(item.TotalValue.ToString("N0"))</strong>
                                            <div class="text-muted small" style="font-size: 0.72rem;">(₹@item.UnitPrice / @item.Unit)</div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(item.Status == "In Stock" ? "bg-success-subtle text-success" : (item.Status == "Low Stock" ? "bg-warning-subtle text-warning fw-bold" : "bg-danger-subtle text-danger")) rounded-pill px-2 py-1" id="stockStatus-@item.Id">
                                            @if (item.Status == "Low Stock")
                                            {
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                            }
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-secondary" onclick="quickAdjustStock(@item.Id, -1)" title="Issue 1 unit (-1)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary" onclick="quickAdjustStock(@item.Id, 1)" title="Add 1 unit (+1)">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                            <button class="btn btn-outline-primary" onclick="openRestockModal(@item.Id, '@item.ItemName.Replace("'", "\\'")')" title="Restock Bulk Quantity">
                                                <i class="bi bi-arrow-repeat"></i> Restock
                                            </button>
                                            <button class="btn btn-outline-danger" onclick="deleteStockItem(@item.Id, '@item.ItemName.Replace("'", "\\'")')" title="Delete Material">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No material items found in stock. Click "+ Add School Material" to begin!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

