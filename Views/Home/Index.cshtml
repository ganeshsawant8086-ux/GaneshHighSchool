            <div class="table-responsive">
                <table class="modern-table" id="studentsMainTable">
                    <thead>
                        <tr>
                            <th>Roll / ID</th>
                            <th>Student Name</th>
                            <th>Class / Standard</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>Parent Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="studentsTableBody">
                        @foreach (var s in Model.Students)
                        {
                            <tr id="student-row-@s.ID" data-standard="@s.Standard">
                                <td><span class="fw-bold text-primary">#@s.ID</span></td>
                                <td>
                                    <div class="user-avatar-cell">
                                        <div class="avatar-initials">@(s.FirstName.Length > 0 ? s.FirstName[0].ToString() : "S")@(s.LastName != null && s.LastName.Length > 0 ? s.LastName[0].ToString() : "")</div>
                                        <div>
                                            <p class="avatar-info-name">@s.FirstName @s.LastName</p>
                                            <p class="avatar-info-sub">Student ID: @s.ID</p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-pill-custom badge-class">Class @(s.Standard)th</span>
                                </td>
                                <td>
                                    <span class="badge-pill-custom @(s.StudentGender == "Male" ? "badge-gender-male" : "badge-gender-female")">
                                        @s.StudentGender
                                    </span>
                                </td>
                                <td>@(s.Age ?? 14) yrs</td>
                                <td>
                                    <a href="tel:@s.MobileNumber" class="text-decoration-none text-dark">
                                        <i class="bi bi-telephone text-primary me-1"></i>@(s.MobileNumber ?? "N/A")
                                    </a>
                                </td>
                                <td>
                                    <div class="action-btn-group">
                                        <button type="button" class="action-btn text-info" onclick="viewStudentRecord(@s.ID, '@(s.FirstName) @(s.LastName)', '@s.Standard', '@s.StudentGender', '@(s.Age ?? 14)', '@(s.MobileNumber ?? "N/A")')" title="View Student Record Profile">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <a href="/Students/Edit/@s.ID" class="action-btn text-primary" title="Edit Student">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="action-btn text-danger action-btn-danger" onclick="deleteStudent(@s.ID)" title="Delete Student">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

