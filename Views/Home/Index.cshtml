@model Ganesh1.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard - Ganesh High School";
}

<!-- Interactive Quick Module Tabs Navigation -->
<div class="module-tabs">
    <button class="module-tab-btn active" data-section="dashboard-section">
        <i class="bi bi-grid-fill"></i> Overview
    </button>
    <button class="module-tab-btn" data-section="students-section">
        <i class="bi bi-people-fill"></i> Students Data
    </button>
    <button class="module-tab-btn" data-section="teachers-section">
        <i class="bi bi-person-badge-fill"></i> Teachers
    </button>
    <button class="module-tab-btn" data-section="teacherpayments-section">
        <i class="bi bi-cash-stack"></i> Teacher Payments
    </button>
    <button class="module-tab-btn" data-section="passouts-section">
        <i class="bi bi-trophy-fill"></i> 10th Board Passouts
    </button>
    <button class="module-tab-btn" data-section="classes-section">
        <i class="bi bi-building"></i> Classes
    </button>
    <button class="module-tab-btn" data-section="subjects-section">
        <i class="bi bi-book-half"></i> Subjects
    </button>
    <button class="module-tab-btn" data-section="attendance-section">
        <i class="bi bi-calendar-check-fill"></i> Attendance
    </button>
    <button class="module-tab-btn" data-section="fees-section">
        <i class="bi bi-wallet2"></i> Fee Structure
    </button>
    <button class="module-tab-btn" data-section="notices-section">
        <i class="bi bi-megaphone-fill"></i> Notices
    </button>
    <button class="module-tab-btn" data-section="library-section">
        <i class="bi bi-journal-bookmark-fill"></i> Library
    </button>
    <button class="module-tab-btn" data-section="events-section">
        <i class="bi bi-calendar-event-fill"></i> Events
    </button>
    <button class="module-tab-btn" data-section="reports-section">
        <i class="bi bi-graph-up"></i> Reports
    </button>
    <button class="module-tab-btn" data-section="stock-section">
        <i class="bi bi-boxes text-warning"></i> Stock & Materials (Clerk)
    </button>
    <button class="module-tab-btn" data-section="contact-section">
        <i class="bi bi-telephone-fill"></i> Contact
    </button>
</div>

<!-- SECTION: TEACHER PAYMENTS -->
<div id="teacherpayments-section" class="content-section">
    <div class="custom-card mb-4 shadow-sm border">
        <div class="custom-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="card-title-group">
                <div class="card-icon-badge bg-success-subtle text-success">
                    <i class="bi bi-cash-stack"></i>
                </div>
                <div>
                    <h3 class="card-title-text">Teacher Payment & Remuneration Details</h3>
                    <p class="card-subtitle-text">Attendance, holidays, daily salary, statutory deductions & final salary calculation</p>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <label class="small fw-bold text-muted mb-0">Select Teacher:</label>
                <select id="dashTeacherSelect" class="form-select form-select-sm" style="min-width: 220px;" onchange="loadDashTeacherPayment(this.value)">
                    @foreach (var teacher in Model.Teachers)
                    {
                        <option value="@teacher.Id">@teacher.FullName (@teacher.SubjectExpertise)</option>
                    }
                </select>
                <a asp-controller="TeacherPayments" asp-action="Index" class="btn btn-sm btn-primary">
                    <i class="bi bi-cash-stack me-1"></i> Full Payroll Module
                </a>
            </div>
        </div>
        <div class="custom-card-body p-4">
            <!-- Detailed Teacher Payment Card -->
            <div id="dashPaymentContainer">
                <div class="row g-4 align-items-stretch">
                    <!-- Teacher Profile Box -->
                    <div class="col-lg-4">
                        <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div id="dashTeacherAvatar" style="width: 56px; height: 56px; border-radius: 50%; background: #2563eb; color: white; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold;">
                                        M
                                    </div>
                                    <div>
                                        <h5 class="mb-0 fw-bold text-dark" id="dashTeacherName">Teacher Name</h5>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 rounded-pill" id="dashTeacherDept">Department</span>
                                    </div>
                                </div>
                                <div class="small d-flex flex-column gap-1 text-muted">
                                    <div><i class="bi bi-mortarboard text-primary me-1"></i> <strong>Qualification:</strong> <span id="dashTeacherQual">Loading...</span></div>
                                    <div><i class="bi bi-clock-history text-info me-1"></i> <strong>Experience:</strong> <span id="dashTeacherExp">0</span> Years</div>
                                    <div><i class="bi bi-telephone-fill text-success me-1"></i> <strong>Phone:</strong> <span id="dashTeacherPhone">-</span></div>
                                    <div><i class="bi bi-envelope-fill text-secondary me-1"></i> <strong>Email:</strong> <span id="dashTeacherEmail">-</span></div>
                                    <div><i class="bi bi-calendar-check text-warning me-1"></i> <strong>Joining:</strong> <span id="dashTeacherJoin">-</span></div>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top">
                                <a id="dashTeacherFullLink" href="#" class="btn btn-outline-primary btn-sm w-100">
                                    <i class="bi bi-receipt me-1"></i> View Full Payslip & Records
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Metrics Grid & Final Salary -->
                    <div class="col-lg-8">
                        <div class="row g-2 mb-3">
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 bg-white border rounded-3 text-center shadow-xs">
                                    <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Total Days Worked</div>
                                    <div class="fs-4 fw-bold text-success" id="dashDaysWorked">-- <span class="small text-muted" style="font-size: 0.75rem;">/ 26 d</span></div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 bg-white border rounded-3 text-center shadow-xs">
                                    <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Absences</div>
                                    <div class="fs-4 fw-bold text-danger" id="dashDaysAbsent">-- <span class="small text-muted" style="font-size: 0.75rem;">Days</span></div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 bg-white border rounded-3 text-center shadow-xs">
                                    <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Holidays / Leaves</div>
                                    <div class="fs-4 fw-bold text-info" id="dashHolidays">-- <span class="small text-muted" style="font-size: 0.75rem;">Days</span></div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="p-3 bg-white border rounded-3 text-center shadow-xs">
                                    <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Daily Salary</div>
                                    <div class="fs-4 fw-bold text-dark" id="dashDailySalary">₹0</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="p-3 bg-white border rounded-3 text-center shadow-xs">
                                    <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Gross Salary</div>
                                    <div class="fs-5 fw-bold text-dark" id="dashGrossSalary">₹0.00</div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="p-3 bg-white border rounded-3 text-center shadow-xs">
                                    <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Salary Deductions</div>
                                    <div class="fs-5 fw-bold text-danger" id="dashDeductions">-₹0.00</div>
                                </div>
                            </div>
                            <div class="col-sm-12 col-md-4">
                                <div class="p-3 bg-white border rounded-3 text-center shadow-xs">
                                    <div class="text-muted small text-uppercase fw-semibold" style="font-size: 0.72rem;">Last Payment</div>
                                    <div class="fs-6 fw-bold text-primary" id="dashLastPayment">--</div>
                                </div>
                            </div>
                        </div>

                        <!-- Final Salary Calculation Result Banner -->
                        <div class="p-3 rounded-3 text-white d-flex justify-content-between align-items-center flex-wrap gap-2 shadow-sm" style="background: linear-gradient(135deg, #059669 0%, #10b981 100%);">
                            <div>
                                <div class="small text-uppercase fw-bold text-white-50">
                                    <i class="bi bi-check-circle-fill me-1"></i> Final Salary (Net Payable Take-Home)
                                </div>
                                <div class="small text-white text-opacity-90 mt-1">
                                    Formula: (<span id="dashFormulaDays">0</span> Days Worked × ₹<span id="dashFormulaDaily">0</span>) - ₹<span id="dashFormulaDed">0</span> Deductions
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fs-2 fw-bold" id="dashFinalSalary">₹0.00</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     SECTION 1: DASHBOARD OVERVIEW
     ========================================== -->
<div id="dashboard-section" class="content-section active">
    <!-- Hero Banner with Campus Photo (Red Square Section) -->
    <div class="hero-banner">
        <div class="hero-layout">
            <div class="hero-content">
                <div class="hero-pill">
                    <i class="bi bi-patch-check-fill text-warning"></i>
                    <span>Govt. Recognized • ISO 9001:2015 Certified School</span>
                </div>
                <h1 class="hero-title">Ganesh High School</h1>
                <p class="hero-desc">
                    Empowering students with knowledge, leadership, and integrity. Admissions open for Nursery to Class 10th for the academic year 2026–27.
                </p>
                <div class="hero-actions">
                    <button type="button" class="hero-btn hero-btn-white" onclick="openAddStudentModal()">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>+ Register Student</span>
                    </button>
                    <button type="button" class="hero-btn hero-btn-outline" onclick="switchSection('students-section')">
                        <i class="bi bi-people"></i>
                        <span>View Student Records</span>
                    </button>
                    <button type="button" class="hero-btn hero-btn-outline" onclick="openAddPassoutModal()">
                        <i class="bi bi-trophy"></i>
                        <span>+ Add Board Record</span>
                    </button>
                </div>
            </div>
            <!-- School Campus Photo (Right Side Red Square) -->
            <div class="hero-image-wrapper">
                <div class="hero-image-card">
                    <img src="~/images/school-campus.jpg" alt="Ganesh High School Main Campus Building" class="hero-image" />
                    <div class="hero-image-overlay">
                        <div class="hero-image-badge">
                            <i class="bi bi-building-fill text-warning me-1"></i>
                            <span>Main Academic Campus Building &bull; Est. 1998</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Key Performance Stats Grid (Live Data from Database) -->
    <div class="stats-grid">
        <div class="stat-card" onclick="switchSection('students-section')" style="cursor: pointer;">
            <div class="stat-info">
                <span class="stat-label">Total Students</span>
                <span class="stat-value" id="totalStudentsStat">@Model.TotalStudents</span>
                <span class="stat-sub">
                    <i class="bi bi-arrow-up-right"></i> Enrolled & Active
                </span>
            </div>
            <div class="stat-icon-wrap stat-icon-blue">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>

        <div class="stat-card" onclick="switchSection('teachers-section')" style="cursor: pointer;">
            <div class="stat-info">
                <span class="stat-label">Faculty Staff</span>
                <span class="stat-value" id="totalTeachersStat">@Model.TotalTeachers</span>
                <span class="stat-sub">
                    <i class="bi bi-check-circle"></i> Experienced Teachers
                </span>
            </div>
            <div class="stat-icon-wrap stat-icon-purple">
                <i class="bi bi-person-badge-fill"></i>
            </div>
        </div>

        <div class="stat-card" onclick="switchSection('passouts-section')" style="cursor: pointer;">
            <div class="stat-info">
                <span class="stat-label">10th Passouts</span>
                <span class="stat-value" id="totalPassoutsStat">@Model.TotalPassouts</span>
                <span class="stat-sub">
                    <i class="bi bi-trophy"></i> Board Achievers
                </span>
            </div>
            <div class="stat-icon-wrap stat-icon-green">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
        </div>

        <div class="stat-card" onclick="switchSection('reports-section')" style="cursor: pointer;">
            <div class="stat-info">
                <span class="stat-label">Avg. Board Score</span>
                <span class="stat-value">@(Model.AveragePassPercentage)%</span>
                <span class="stat-sub">
                    <i class="bi bi-star-fill text-warning"></i> 100% Pass Trend
                </span>
            </div>
            <div class="stat-icon-wrap stat-icon-amber">
                <i class="bi bi-award-fill"></i>
            </div>
        </div>

        <!-- School Clerk: Stock & Material Inventory KPI -->
        <div class="stat-card" onclick="switchSection('stock-section')" style="cursor: pointer;">
            <div class="stat-info">
                <span class="stat-label">Stock Materials (Clerk)</span>
                <span class="stat-value">@Model.TotalStockItems <span class="fs-6 text-muted">SKUs</span></span>
                <span class="stat-sub">
                    <i class="bi bi-boxes text-warning"></i> @Model.TotalStockUnits Units • @(Model.LowStockAlerts > 0 ? Model.LowStockAlerts + " Low Stock" : "All Stocked")
                </span>
            </div>
            <div class="stat-icon-wrap" style="background: rgba(245, 158, 11, 0.15); color: #d97706;">
                <i class="bi bi-boxes"></i>
            </div>
        </div>
    </div>
    <div class="row g-4">
        <!-- Recent Students Table Preview -->
        <div class="col-lg-8">
            <div class="custom-card">
                <div class="custom-card-header">
                    <div class="card-title-group">
                        <div class="card-icon-badge bg-primary-subtle text-primary">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div>
                            <h3 class="card-title-text">Recent Student Admissions (@Model.TotalStudents Registered)</h3>
                            <p class="card-subtitle-text">Active database records with real-time sync</p>
                        </div>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-primary" onclick="openAddStudentModal()">
                            <i class="bi bi-plus-lg me-1"></i> Add Student
                        </button>
                        <button class="btn btn-sm btn-outline-secondary ms-2" onclick="switchSection('students-section')">
                            View All (@Model.TotalStudents)
                        </button>
                    </div>
                </div>
                <div class="custom-card-body p-0">
                    <div class="table-responsive">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Student Name</th>
                                    <th>Class</th>
                                    <th>Gender</th>
                                    <th>Mobile</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Students.Any())
                                {
                                    @foreach (var s in Model.Students.Take(6))
                                    {
                                        <tr>
                                            <td><span class="fw-bold text-primary">#@s.ID</span></td>
                                            <td>
                                                <div class="user-avatar-cell">
                                                    <div class="avatar-initials">@(s.FirstName.Length > 0 ? s.FirstName[0].ToString() : "S")@(s.LastName != null && s.LastName.Length > 0 ? s.LastName[0].ToString() : "")</div>
                                                    <div>
                                                        <p class="avatar-info-name">@s.FirstName @s.LastName</p>
                                                        <p class="avatar-info-sub">Age: @(s.Age ?? 14) yrs</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td><span class="badge-pill-custom badge-class">Class @(s.Standard)th</span></td>
                                            <td>
                                                <span class="badge-pill-custom @(s.StudentGender == "Male" ? "badge-gender-male" : "badge-gender-female")">
                                                    @s.StudentGender
                                                </span>
                                            </td>
                                            <td>
                                                <span class="text-muted"><i class="bi bi-telephone me-1 text-primary"></i>@(s.MobileNumber ?? "N/A")</span>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-1">
                                                    <button type="button" class="btn btn-sm btn-light text-info" onclick="viewStudentRecord(@s.ID, '@(s.FirstName) @(s.LastName)', '@s.Standard', '@s.StudentGender', '@(s.Age ?? 14)', '@(s.MobileNumber ?? "N/A")')" title="View Student Record Profile">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-light text-primary" onclick="viewStudentIDCard(@s.ID)" title="Preview Student ID Card">
                                                        <i class="bi bi-person-badge"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-light text-secondary" onclick="switchSection('students-section')" title="View in Students Directory">
                                                        <i class="bi bi-arrow-right"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No student records found. Click "+ Add Student" to register!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- School Material Stock & Store Room Status (Clerk Live Overview) - Perfectly Fills Gap -->
            <div class="custom-card">
                <div class="custom-card-header">
                    <div class="card-title-group">
                        <div class="card-icon-badge bg-warning-subtle text-warning">
                            <i class="bi bi-boxes"></i>
                        </div>
                        <div>
                            <h3 class="card-title-text">School Material Stock & Store Room Status (Clerk)</h3>
                            <p class="card-subtitle-text">Connected to SQL Server (Database: StudentDB • Table: Stocks)</p>
                        </div>
                    </div>
                    <button class="btn btn-sm btn-outline-warning text-dark fw-bold" onclick="switchSection('stock-section')">
                        Open Stock Room <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
                <div class="custom-card-body">
                    <!-- 4 Quick Clerk Mini Badges -->
                    <div class="row g-2 mb-3">
                        <div class="col-sm-3 col-6">
                            <div class="p-2 border rounded-2 bg-light text-center">
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">Total Value</span>
                                <strong class="text-dark small">₹@Model.TotalInventoryValue.ToString("N0")</strong>
                            </div>
                        </div>
                        <div class="col-sm-3 col-6">
                            <div class="p-2 border rounded-2 bg-light text-center">
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">Total Volume</span>
                                <strong class="text-primary small">@Model.TotalStockUnits Units</strong>
                            </div>
                        </div>
                        <div class="col-sm-3 col-6">
                            <div class="p-2 border rounded-2 bg-light text-center">
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">Material SKUs</span>
                                <strong class="text-dark small">@Model.TotalStockItems Items</strong>
                            </div>
                        </div>
                        <div class="col-sm-3 col-6">
                            <div class="p-2 border rounded-2 bg-light text-center">
                                <span class="small text-muted d-block" style="font-size: 0.72rem;">Low Stock</span>
                                <strong class="small @(Model.LowStockAlerts > 0 ? "text-danger" : "text-success")">@(Model.LowStockAlerts > 0 ? Model.LowStockAlerts + " Alerts" : "Normal")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- 6 Sample Live Stock Items from SQL Database -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <strong class="small text-muted text-uppercase" style="font-size: 0.72rem;">Live Stock Inventory Samples:</strong>
                        <span class="text-muted small" style="font-size: 0.72rem;"><i class="bi bi-database-check text-success me-1"></i>Live SQL Server Data</span>
                    </div>
                    <div class="row g-2">
                        @foreach (var stk in Model.Stocks.Take(6))
                        {
                            <div class="col-sm-6">
                                <div class="p-2 border rounded-2 bg-white d-flex align-items-center justify-content-between">
                                    <div class="me-2 text-truncate" style="max-width: 190px;">
                                        <strong class="d-block text-truncate small" title="@stk.ItemName">@stk.ItemName</strong>
                                        <span class="text-muted" style="font-size: 0.68rem;">@stk.Category • @stk.Location</span>
                                    </div>
                                    <div class="text-end flex-shrink-0">
                                        <span class="badge @(stk.Status == "In Stock" ? "bg-success-subtle text-success" : (stk.Status == "Low Stock" ? "bg-warning-subtle text-warning fw-bold" : "bg-danger-subtle text-danger"))" style="font-size: 0.68rem;">
                                            @stk.Quantity @stk.Unit
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Campus Facilities & Academic Resource Highlights (Matching Right Side Infrastructure) -->
                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <strong class="small text-muted text-uppercase" style="font-size: 0.72rem;">Student Academic Support & Dispatch Amenities:</strong>
                            <span class="badge bg-primary-subtle text-primary" style="font-size: 0.7rem;">Campus Ready</span>
                        </div>
                        <div class="row g-2">
                            <div class="col-sm-6">
                                <div class="p-2 border rounded-2 bg-light d-flex align-items-center gap-2">
                                    <div class="card-icon-badge bg-primary-subtle text-primary" style="width: 32px; height: 32px; font-size: 0.95rem;">
                                        <i class="bi bi-backpack4-fill"></i>
                                    </div>
                                    <div class="text-truncate">
                                        <strong class="d-block text-truncate small">Free Textbook & Uniform Distribution</strong>
                                        <span class="text-muted" style="font-size: 0.68rem;">Govt. aided complete kit sets issued at admission</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-2 border rounded-2 bg-light d-flex align-items-center gap-2">
                                    <div class="card-icon-badge bg-success-subtle text-success" style="width: 32px; height: 32px; font-size: 0.95rem;">
                                        <i class="bi bi-flask-fill"></i>
                                    </div>
                                    <div class="text-truncate">
                                        <strong class="d-block text-truncate small">Science & STEM Lab Consumables</strong>
                                        <span class="text-muted" style="font-size: 0.68rem;">Chemistry, Physics & Robotics apparatus stocked</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-2 border rounded-2 bg-light d-flex align-items-center gap-2">
                                    <div class="card-icon-badge bg-warning-subtle text-warning" style="width: 32px; height: 32px; font-size: 0.95rem;">
                                        <i class="bi bi-trophy-fill"></i>
                                    </div>
                                    <div class="text-truncate">
                                        <strong class="d-block text-truncate small">Sports & Athletic Ground Equipment</strong>
