<script>
    // Filter students table by standard
    function filterStudentsByClass(std) {
        const rows = document.querySelectorAll('#studentsTableBody tr');
        rows.forEach(r => {
            const rowStd = r.getAttribute('data-standard');
            if (std === 'all' || rowStd === std) {
                r.style.display = '';
            } else {
                r.style.display = 'none';
            }
        });
    }

    // Live AJAX inspector for teacher payments
    function loadDashTeacherPayment(teacherId) {
        if (!teacherId) return;
        fetch('/TeacherPayments/GetTeacherPaymentSummary?id=' + encodeURIComponent(teacherId))
            .then(res => res.json())
            .then(data => {
                if (!data || !data.success) return;
                const t = data.teacher;
                const p = data.payment;

                document.getElementById('dashTeacherName').textContent = t.fullName;
                document.getElementById('dashTeacherDept').textContent = t.subject + ' Department';
                document.getElementById('dashTeacherQual').textContent = t.qualification;
                document.getElementById('dashTeacherExp').textContent = t.experience;
                document.getElementById('dashTeacherPhone').textContent = t.phone;
                document.getElementById('dashTeacherEmail').textContent = t.email;
                document.getElementById('dashTeacherJoin').textContent = t.joiningDate;
                document.getElementById('dashTeacherAvatar').textContent = t.fullName.charAt(0);
                document.getElementById('dashTeacherFullLink').setAttribute('href', '/TeacherPayments/Details/' + t.id);

                document.getElementById('dashDaysWorked').innerHTML = `${p.totalDaysWorked} <span class="small text-muted" style="font-size: 0.75rem;">/ ${p.totalWorkingDays} d</span>`;
                document.getElementById('dashDaysAbsent').innerHTML = `${p.absences} <span class="small text-muted" style="font-size: 0.75rem;">Days</span>`;
                document.getElementById('dashHolidays').innerHTML = `${p.holidays} <span class="small text-muted" style="font-size: 0.75rem;">Days</span>`;
                document.getElementById('dashDailySalary').textContent = '₹' + Number(p.dailySalary).toLocaleString('en-IN');
                document.getElementById('dashGrossSalary').textContent = '₹' + Number(p.grossSalary).toLocaleString('en-IN', { minimumFractionDigits: 2 });
                document.getElementById('dashDeductions').textContent = '-₹' + Number(p.salaryDeductions).toLocaleString('en-IN', { minimumFractionDigits: 2 });
                document.getElementById('dashLastPayment').textContent = '₹' + Number(p.lastPaymentAmount).toLocaleString('en-IN') + ' (' + p.lastPaymentDate + ')';

                document.getElementById('dashFormulaDays').textContent = p.totalDaysWorked;
                document.getElementById('dashFormulaDaily').textContent = Number(p.dailySalary).toLocaleString('en-IN');
                document.getElementById('dashFormulaDed').textContent = Number(p.salaryDeductions).toLocaleString('en-IN');
                document.getElementById('dashFinalSalary').textContent = '₹' + Number(p.finalSalary).toLocaleString('en-IN', { minimumFractionDigits: 2 });
            })
            .catch(err => console.error('Error fetching teacher payment summary:', err));
    }

    document.addEventListener('DOMContentLoaded', () => {
        const select = document.getElementById('dashTeacherSelect');
        if (select && select.value) {
            loadDashTeacherPayment(select.value);
        }
    });
</script>