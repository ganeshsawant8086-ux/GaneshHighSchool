@model IEnumerable<Ganesh1.Models.Passout>

@{
    ViewData["Title"] = "10th Board Passouts - Ganesh High School";
}

<div class="custom-card">
    <div class="custom-card-header">
        <div class="card-title-group">
            <div class="card-icon-badge bg-success-subtle text-success">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div>
                <h3 class="card-title-text">10th Standard Board Passouts & Achievers</h3>
                <p class="card-subtitle-text">Historical records and merit milestones</p>
            </div>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-lg me-1"></i> + Add Passout Record
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">
                <i class="bi bi-grid-fill me-1"></i> Dashboard
            </a>
        </div>
    </div>
    <div class="custom-card-body">
        <div class="passouts-grid">
            @foreach (var p in Model)
            {
                <div class="passout-card-v2">
                    <div class="passout-header">
                        <span class="passout-year-badge">Class 10th - @p.Year</span>
                        <span class="passout-score">@p.Percentage%</span>
                    </div>
                    <h4 class="passout-name">@p.FullName</h4>
                    <div class="passout-spec">
                        <i class="bi bi-award-fill text-warning"></i>
                        <span>Stream: @(p.Specialization ?? "General")</span>
                    </div>
                    <div class="progress mb-3" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: @(p.Percentage)%;"></div>
                    </div>
                    <div class="passout-contact">
                        <span><i class="bi bi-envelope me-1"></i>@(p.ExampleContact ?? "N/A")</span>
                        <div class="d-flex gap-2 align-items-center">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Remove passout record?');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
